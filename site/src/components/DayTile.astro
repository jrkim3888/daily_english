---
import type { Day } from '../lib/data';
import { formatDateEn } from '../lib/data';

interface Props {
  day: Day;
}
const { day } = Astro.props;
const en = formatDateEn(day.date);
const words = day.newVocab.length + day.reviewVocab.length;
const sents = day.newSentences.length + day.reviewSentences.length;
---
<a class:list={['tile', 'card', { ep: day.post }]} href={`/days/${day.date}/`}>
  <span class="d">
    <span class="num">{en.day}</span>
    <span class="wd mono">{en.weekday}</span>
  </span>
  <span class="info">
    <span class="t">{day.post ? day.post.title : '복습'}</span>
    <span class="m">
      {day.post?.episode && <span class="pill">EP {day.post.episode}</span>}
      <span>{words} {words === 1 ? 'word' : 'words'} · {sents} {sents === 1 ? 'sentence' : 'sentences'}</span>
    </span>
  </span>
</a>

<style>
  .tile { display: flex; gap: 16px; align-items: center; padding: 14px 18px; text-decoration: none; border-radius: 18px; transition: transform 0.2s, border-color 0.2s; }
  .tile:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .d { display: flex; flex-direction: column; align-items: center; min-width: 44px; }
  .num { font-family: var(--serif); font-size: 36px; line-height: 1; letter-spacing: -0.03em; }
  .wd { font-size: 10.5px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .info { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .t { font-weight: 600; letter-spacing: -0.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tile:not(.ep) .t { color: var(--muted); font-weight: 500; }
  .m { display: flex; gap: 8px; align-items: center; font-size: 12.5px; color: var(--muted); flex-wrap: wrap; }
  .pill { font-family: var(--mono); font-size: 10.5px; padding: 1px 7px; border-radius: 999px; background: var(--lime); color: var(--lime-ink); }
</style>
