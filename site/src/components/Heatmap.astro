---
import type { Day } from '../lib/data';

interface Props {
  days: Day[];
}
const { days } = Astro.props;
const byDate = new Map(days.map((d) => [d.date, d]));
const iso = (t: number) => new Date(t).toISOString().slice(0, 10);
const DAY = 86400000;

const dates = days.map((d) => d.date).sort();
const first = Date.parse(dates[0] + 'T00:00:00Z');
const last = Date.parse(dates[dates.length - 1] + 'T00:00:00Z');
// Start on the Sunday on/before the first day.
const start = first - new Date(first).getUTCDay() * DAY;
const weeks: { date: string; level: number; label: string }[][] = [];
for (let t = start; t <= last; t += 7 * DAY) {
  const week = [];
  for (let i = 0; i < 7; i++) {
    const date = iso(t + i * DAY);
    const d = byDate.get(date);
    const level = !d ? 0 : d.post ? 2 : 1;
    week.push({ date, level, label: d ? `${date} · ${d.post ? d.post.title : '복습'}` : date });
  }
  weeks.push(week);
}
const monthLabels = weeks.map((w, i) => {
  const m = Number(w[0].date.slice(5, 7));
  const prev = i > 0 ? Number(weeks[i - 1][0].date.slice(5, 7)) : -1;
  return m !== prev ? `${m}월` : '';
});
const inRange = (date: string) => date >= dates[0] && date <= dates[dates.length - 1];
---
<div class="heat card">
  <div class="scroll">
    <div class="months" style={`grid-template-columns: repeat(${weeks.length}, 14px)`}>
      {monthLabels.map((l) => <span>{l}</span>)}
    </div>
    <div class="grid" style={`grid-template-columns: repeat(${weeks.length}, 14px)`}>
      {weeks.map((w) => (
        <div class="col">
          {w.map((c) => inRange(c.date)
            ? (c.level ? <a class={`c l${c.level}`} href={`/days/${c.date}/`} title={c.label} aria-label={c.label}></a> : <span class="c l0" title={c.label}></span>)
            : <span class="c out"></span>)}
        </div>
      ))}
    </div>
  </div>
  <div class="legend">
    <span><i class="c l0"></i>기록 없음</span>
    <span><i class="c l1"></i>복습</span>
    <span><i class="c l2"></i>새 에피소드</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.heat .scroll').forEach((el) => (el.scrollLeft = el.scrollWidth));
</script>

<style>
  .heat { padding: 20px 22px 16px; }
  .scroll { overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .months, .grid { display: grid; gap: 3px; width: max-content; }
  .months span { font-size: 11px; color: var(--muted); white-space: nowrap; height: 18px; }
  .col { display: grid; grid-template-rows: repeat(7, 14px); gap: 3px; }
  .c { display: block; width: 14px; height: 14px; border-radius: 4px; transition: transform 0.15s; }
  a.c:hover { transform: scale(1.35); }
  .l0 { background: var(--line); }
  .l1 { background: color-mix(in oklab, var(--accent) 38%, var(--line)); }
  .l2 { background: var(--lime); box-shadow: 0 0 0 1px color-mix(in oklab, var(--lime-ink) 12%, transparent) inset; }
  .out { background: transparent; }
  .legend { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 10px; font-size: 12px; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 11px; height: 11px; }
</style>
