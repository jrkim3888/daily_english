---
import Base from '../../layouts/Base.astro';
import LibraryHead from '../../components/LibraryHead.astro';
import SearchBar from '../../components/SearchBar.astro';
import Spotlight from '../../components/Spotlight.astro';
import Icon from '../../components/Icon.astro';
import { getAllVocab } from '../../lib/data';

const vocab = getAllVocab();
const sections = ['Words', 'Phrasal Verbs', 'Idioms'].filter((s) => vocab.some((v) => v.section === s));
---
<Base title="단어장">
  <LibraryHead active="vocab" count={vocab.length} />
  <div class="lib">
    <div class="side"><Spotlight kind="vocab" /></div>
    <div class="main">
      <SearchBar target="[data-item]" placeholder="단어나 뜻으로 검색" sections={sections} />
      <ul class="vlist rows card" data-group>
        {vocab.map((v) => (
          <li class="v" data-item data-sec={v.section} data-text={v.term} data-meaning={v.meaning}>
            <span class="term">{v.term}</span>
            <span class="meaning">{v.meaning}</span>
            <button type="button" class="sp" data-action="speak" data-text={v.term} aria-label={`${v.term} 발음`}><Icon name="speak" size={14} /></button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<script src="../../lib/study.ts"></script>

<style>
  .lib { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; align-items: start; }
  .side { grid-column: 2; grid-row: 1; position: sticky; top: 84px; }
  .main { grid-column: 1; grid-row: 1; min-width: 0; }
  .v { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) 30px; align-items: center; gap: 14px; padding: 11px 16px 11px 20px; cursor: pointer; transition: background 0.15s; }
  .v:hover { background: color-mix(in oklab, var(--ink) 4%, transparent); }
  .v:global(.selected) { background: color-mix(in oklab, var(--lime) 35%, transparent); }
  .term { font-weight: 700; letter-spacing: -0.025em; overflow-wrap: anywhere; }
  .meaning { font-size: 14px; color: var(--muted); word-break: keep-all; }
  .sp { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-solid); color: var(--ink-2); cursor: pointer; }
  .sp:hover { color: var(--accent); }
  @media (max-width: 900px) {
    .lib { grid-template-columns: 1fr; }
    .side { grid-column: 1; position: static; }
    .main { grid-row: 2; }
  }
  @media (max-width: 520px) {
    .v { grid-template-columns: minmax(0, 1fr) 30px; gap: 2px 12px; padding: 11px 14px 11px 16px; }
    .meaning { grid-column: 1; }
    .sp { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
