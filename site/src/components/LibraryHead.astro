---
interface Props {
  active: 'vocab' | 'sentences';
  count: number;
}
const { active, count } = Astro.props;
---
<header class="page-head">
  <p class="eyebrow">Library · {count.toLocaleString()} {active === 'vocab' ? 'expressions' : 'sentences'}</p>
  <h1 class="display">{active === 'vocab' ? <>Word <em>bank.</em></> : <>Lines to <em>keep.</em></>}</h1>
  <nav class="tabs">
    <a href="/library/" aria-current={active === 'vocab' ? 'page' : undefined}>단어장</a>
    <a href="/library/sentences/" aria-current={active === 'sentences' ? 'page' : undefined}>문장</a>
  </nav>
</header>

<style>
  .page-head { margin: 12px 0 24px; }
  .page-head .eyebrow { margin: 0 0 10px; }
  .page-head h1 { font-size: clamp(48px, 8vw, 104px); }
  .tabs { display: inline-flex; gap: 4px; margin-top: 20px; padding: 4px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); }
  .tabs a { padding: 7px 16px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 600; color: var(--muted); }
  .tabs a[aria-current='page'] { background: var(--ink); color: var(--bg); }
</style>
