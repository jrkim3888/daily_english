---
import Base from '../../layouts/Base.astro';
import HistoryView from '../../components/HistoryView.astro';
import { getMonths } from '../../lib/data';

const [latest] = getMonths();
---
<Base title="History">
  {latest ? <HistoryView year={latest.year} month={latest.month} /> : <p class="muted">No records yet.</p>}
</Base>
