---
interface Props {
  active: 'vocab' | 'sentences';
  count: number;
}
const { active, count } = Astro.props;
---
<header class="page-head">
  <p class="eyebrow">Library</p>
  <h1 class="display">{active === 'vocab' ? '단어장' : '문장 모음'} <span>{count.toLocaleString()}</span></h1>
  <nav class="tabs">
    <a href="/library/" aria-current={active === 'vocab' ? 'page' : undefined}>단어</a>
    <a href="/library/sentences/" aria-current={active === 'sentences' ? 'page' : undefined}>문장</a>
  </nav>
</header>

<style>
  .page-head { margin: 12px 0 22px; }
  .page-head .eyebrow { margin: 0 0 8px; }
  .page-head h1 { font-size: clamp(36px, 6vw, 56px); }
  .page-head h1 span { font-size: 0.45em; font-weight: 700; color: var(--muted); letter-spacing: -0.03em; vertical-align: middle; }
  .tabs { display: inline-flex; gap: 4px; margin-top: 18px; padding: 4px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); }
  .tabs a { padding: 7px 18px; border-radius: 999px; text-decoration: none; font-size: 14px; font-weight: 650; color: var(--muted); }
  .tabs a[aria-current='page'] { background: var(--ink); color: var(--bg); }
</style>
