---
interface Props {
  target: string;
  placeholder: string;
  sections?: string[];
}
const { target, placeholder, sections = [] } = Astro.props;
---
<div class="searchbar" data-search={target}>
  <input class="search" type="search" placeholder={placeholder} aria-label={placeholder} />
  {sections.length > 0 && (
    <div class="chips">
      <button class="chip" type="button" data-section="" aria-pressed="true">전체</button>
      {sections.map((s) => <button class="chip" type="button" data-section={s} aria-pressed="false">{s}</button>)}
    </div>
  )}
  <span class="count mono" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-search]').forEach((bar) => {
    const input = bar.querySelector('input')!;
    const count = bar.querySelector('.count')!;
    const items = [...document.querySelectorAll<HTMLElement>(bar.dataset.search!)];
    const text = items.map((el) => el.textContent!.toLowerCase());
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    let section = '';

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((el, i) => {
        const hit = (!q || text[i].includes(q)) && (!section || el.dataset.sec === section);
        el.hidden = !hit;
        if (hit) shown++;
      });
      groups.forEach((g) => (g.hidden = !g.querySelector('[data-item]:not([hidden])')));
      count.textContent = q || section ? `${shown.toLocaleString()}개` : '';
    };

    input.addEventListener('input', apply);
    bar.querySelectorAll<HTMLElement>('[data-section]').forEach((chip) =>
      chip.addEventListener('click', () => {
        section = chip.dataset.section!;
        bar.querySelectorAll('[data-section]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      }),
    );
  });
</script>

<style>
  .searchbar {
    position: sticky; top: 72px; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    padding: 10px; margin-bottom: 18px; border-radius: 20px; border: 1px solid var(--line);
    background: var(--surface); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: var(--shadow);
  }
  .search {
    flex: 1 1 260px; min-width: 0; font: inherit; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: var(--surface-solid); color: var(--ink);
  }
  .search:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .count { font-size: 12px; color: var(--muted); padding: 0 6px; }
</style>
