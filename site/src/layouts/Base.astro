---
interface Props {
  title?: string;
  description?: string;
}
const { title, description = '입이 트이는 영어로 쌓아가는 매일의 단어와 문장' } = Astro.props;
const fullTitle = title ? `${title} · 오늘의 영어` : '오늘의 영어';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '날짜별' },
  { href: '/vocab/', label: '단어장' },
  { href: '/sentences/', label: '문장' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">오늘의 영어</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={(n.href === '/' ? path === '/' || path.startsWith('/days/') : path.startsWith(n.href)) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      출처: <a href="https://blog.naver.com/witjung">witjung 블로그</a> · EBS 입이 트이는 영어
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --surface: #ffffff;
    --text: #1f2421;
    --muted: #6b716d;
    --line: #e4e0d6;
    --accent: #2f6f5e;
    --accent-soft: #e3efe9;
    --mark: #fff1c2;
    --serif: 'Iowan Old Style', 'Charter', Georgia, 'Apple SD Gothic Neo', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard', 'Noto Sans KR', 'Segoe UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151816;
      --surface: #1d211f;
      --text: #e6e8e5;
      --muted: #9aa19c;
      --line: #2e3430;
      --accent: #7cc2a9;
      --accent-soft: #23332d;
      --mark: #4a3f1c;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    line-height: 1.6;
  }
  a { color: var(--accent); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .site-header { border-bottom: 1px solid var(--line); background: var(--surface); position: sticky; top: 0; z-index: 10; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 56px; }
  .brand { font-family: var(--serif); font-size: 1.2rem; font-weight: 700; color: var(--text); text-decoration: none; }
  nav { display: flex; gap: 4px; }
  nav a { color: var(--muted); text-decoration: none; padding: 6px 10px; border-radius: 8px; font-size: 0.95rem; }
  nav a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  main { padding-top: 28px; padding-bottom: 48px; }
  h1 { font-family: var(--serif); font-size: 1.7rem; line-height: 1.3; margin: 0 0 6px; }
  h2 { font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); margin: 28px 0 10px; }
  .muted { color: var(--muted); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 4px 18px; }
  .vocab { list-style: none; margin: 0; padding: 0; }
  .vocab li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .vocab li:last-child { border-bottom: 0; }
  .term { font-weight: 600; overflow-wrap: anywhere; }
  .meaning { color: var(--muted); }
  .sentences { list-style: none; margin: 0; padding: 0; }
  .sentences li { font-family: var(--serif); font-size: 1.12rem; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .sentences li:last-child { border-bottom: 0; }
  .site-footer { color: var(--muted); font-size: 0.85rem; padding-bottom: 32px; }
  .search { width: 100%; font: inherit; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--text); }
  .search:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  body.hide-meaning .meaning { color: transparent; background: var(--line); border-radius: 4px; cursor: pointer; }
  body.hide-meaning .meaning.revealed { color: var(--muted); background: none; }
  @media (max-width: 480px) {
    .vocab li { grid-template-columns: 1fr; gap: 2px; }
    h1 { font-size: 1.45rem; }
  }
</style>
