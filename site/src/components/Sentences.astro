---
import { markTerms } from '../lib/data';
import Icon from './Icon.astro';

interface Props {
  items: { text: string; tag: 'new' | 'review' }[];
  terms: string[];
}
const { items, terms } = Astro.props;
const marked = items.map((s) => ({ ...s, parts: markTerms(s.text, terms) }));
const hasMarks = marked.some((s) => s.parts.some((p) => p.mark));
---
<section class="sentences" id="sentences" data-sentences>
  <div class="section-head">
    <h2>Sentences <small>Read them out loud</small></h2>
    {hasMarks && <button class="chip" type="button" data-action="blanks" aria-pressed="false"><Icon name="eye" size={14} /> Blank quiz</button>}
  </div>
  <ol class="list">
    {marked.map((s, i) => (
      <li class="card s">
        <span class="no">{String(i + 1).padStart(2, '0')}</span>
        <p class="text">
          {s.parts.map((p) => (p.mark ? <mark class="hl" data-word={p.text}>{p.text}</mark> : p.text))}
        </p>
        <div class="row">
          <span class:list={['tag', s.tag]}>{s.tag === 'new' ? 'New' : 'Review'}</span>
          <button type="button" class="listen" data-action="speak" data-text={s.text}><Icon name="speak" size={15} /> Listen</button>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .s { display: grid; grid-template-columns: 44px 1fr; gap: 4px 14px; padding: 20px 22px; }
  #sentences { scroll-margin-top: 80px; }
  .no { font-size: 13px; font-weight: 700; color: var(--muted); padding-top: 5px; }
  .text { margin: 0; font-size: clamp(19px, 2.2vw, 23px); font-weight: 650; line-height: 1.45; letter-spacing: -0.025em; }
  .row { grid-column: 2; display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .listen { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; color: var(--accent); font-size: 13px; font-weight: 600; cursor: pointer; padding: 4px 0; }
  :global(.blanks) .hl { color: transparent; background: none; border-bottom: 2px dashed var(--ink-2); cursor: pointer; transition: color 0.2s; }
  :global(.blanks) .hl.revealed { color: inherit; background: linear-gradient(transparent 58%, var(--lime) 58%); border-bottom-color: transparent; }
  @media (max-width: 520px) { .s { grid-template-columns: 1fr; padding: 18px; } .no { padding: 0; } .row { grid-column: 1; } }
</style>
