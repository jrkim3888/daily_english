---
import Heatmap from './Heatmap.astro';
import DayRow from './DayRow.astro';
import MonthPicker from './MonthPicker.astro';
import { getDays, getMonths, MONTHS_LONG, plural } from '../lib/data';

interface Props {
  year: number;
  month: number;
}
const { year, month } = Astro.props;

const days = getDays();
const months = getMonths();
const current = months.find((m) => m.year === year && m.month === month)!;
const stats = [
  { n: days.length, l: 'Days studied' },
  { n: days.reduce((n, d) => n + d.episodes.length, 0), l: 'Episodes' },
  { n: days.reduce((n, d) => n + d.newVocab.length, 0), l: 'New words learned' },
];
---
<header class="page-head">
  <p class="eyebrow">History</p>
  <h1 class="display">Study log</h1>
</header>

<div class="stats">
  {stats.map((s) => <div class="card stat"><span class="n">{s.n.toLocaleString()}</span><span class="l">{s.l}</span></div>)}
</div>

<MonthPicker months={months} year={year} month={month} base="/history" />
<Heatmap days={days.filter((d) => d.date.startsWith(`${year}-`))} />

<section>
  <div class="section-head">
    <h2>{MONTHS_LONG[month - 1]} {year} <small>{plural(current.days.length, 'day')} · {plural(current.days.reduce((n, d) => n + d.episodes.length, 0), 'episode')}</small></h2>
  </div>
  <ul class="rows card">
    {current.days.map((d) => <DayRow day={d} />)}
  </ul>
</section>

<style>
  .page-head { margin: 12px 0 24px; }
  .page-head .eyebrow { margin: 0 0 8px; }
  .page-head h1 { font-size: clamp(36px, 6vw, 56px); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 14px; }
  .stat { padding: 18px 20px; display: flex; flex-direction: column; gap: 2px; }
  .stat .n { font-size: 38px; font-weight: 800; line-height: 1; letter-spacing: -0.05em; }
  .stat .l { font-size: 13px; color: var(--muted); font-weight: 600; }
  @media (max-width: 640px) {
    .stats { gap: 8px; }
    .stat { padding: 14px; }
    .stat .n { font-size: 28px; }
  }
</style>
