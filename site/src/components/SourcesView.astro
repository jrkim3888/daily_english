---
import Icon from './Icon.astro';
import MonthPicker from './MonthPicker.astro';
import { getDays, getSourceMonths, formatDate, plural, MONTHS_LONG } from '../lib/data';

interface Props {
  year: number;
  month: number;
}
const { year, month } = Astro.props;
const total = getDays().filter((d) => d.post).length;
const months = getSourceMonths();
const current = months.find((m) => m.year === year && m.month === month)!;
---
<header class="page-head">
  <p class="eyebrow">Sources</p>
  <h1 class="display">Episodes</h1>
  <p class="muted lede">{plural(total, 'episode')} of EBS Radio, collected from the <a href="https://blog.naver.com/witjung">witjung</a> blog.</p>
</header>

<MonthPicker months={months} year={year} month={month} base="/sources" />

<section>
  <div class="section-head">
    <h2>Aired in {MONTHS_LONG[month - 1]} {year} <small>{plural(current.days.length, 'episode')}</small></h2>
  </div>
  <ul class="rows card">
    {current.days.map((d) => (
      <li class="ep">
        <span class="aired">{formatDate(d.post!.aired || d.date)}</span>
        <a class="title" href={`/days/${d.date}/`}>{d.post!.title}</a>
        <span class="count">{plural(d.newVocab.length, 'word')} · {plural(d.newSentences.length, 'sentence')}</span>
        <span class="links">
          <a class="chip" href={`/days/${d.date}/`}>Study</a>
          <a class="chip" href={d.post!.link} target="_blank" rel="noopener" aria-label={`${d.post!.title} on the blog`}>Post <Icon name="external" size={12} /></a>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .page-head { margin: 12px 0 24px; }
  .page-head .eyebrow { margin: 0 0 8px; }
  .page-head h1 { font-size: clamp(36px, 6vw, 56px); }
  .lede { max-width: 52ch; margin: 12px 0 0; }
  .lede a { color: var(--ink-2); }
  .ep { display: grid; grid-template-columns: 150px minmax(0, 1fr) auto auto; align-items: center; gap: 16px; padding: 12px 20px; }
  .aired { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .title { font-weight: 650; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .title:hover { color: var(--accent); }
  .count { font-size: 13px; color: var(--muted); white-space: nowrap; }
  .links { display: flex; gap: 6px; }
  .links .chip { padding: 5px 11px; font-size: 12.5px; }
  @media (max-width: 720px) {
    .ep { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding: 13px 16px; }
    .aired { grid-column: 1; font-size: 13px; color: var(--muted); }
    .title { grid-column: 1; white-space: normal; }
    .count { grid-column: 1; }
    .links { grid-column: 2; grid-row: 1 / span 3; flex-direction: column; }
  }
</style>
