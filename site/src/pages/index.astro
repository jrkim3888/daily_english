---
import Base from '../layouts/Base.astro';
import DayView from '../components/DayView.astro';
import DayRow from '../components/DayRow.astro';
import { getDays, getAllVocab } from '../lib/data';

const days = getDays();
const [latest] = days;
const recent = days.slice(1, 8);
---
<Base>
  {latest ? <DayView day={latest} librarySize={getAllVocab().length} isToday /> : <p class="muted">No records yet.</p>}

  {recent.length > 0 && (
    <section>
      <div class="section-head">
        <h2>Recently studied</h2>
        <a class="chip" href="/history/">Full history →</a>
      </div>
      <ul class="rows card">
        {recent.map((d) => <DayRow day={d} />)}
      </ul>
    </section>
  )}
</Base>
