---
import Base from '../../layouts/Base.astro';
import DayView from '../../components/DayView.astro';
import { getDays, getAllVocab, formatDate } from '../../lib/data';

export function getStaticPaths() {
  const days = getDays();
  return days.map((day, i) => ({
    params: { date: day.date },
    props: { day, newer: days[i - 1], older: days[i + 1] },
  }));
}

const { day, newer, older } = Astro.props;
---
<Base title={formatDate(day.date)}>
  <DayView day={day} librarySize={getAllVocab().length} />
  <nav class="pager">
    {older ? <a class="card" href={`/days/${older.date}/`}><span class="eyebrow">← Previous</span><b>{older.post?.title ?? 'Review day'}</b><span class="muted">{formatDate(older.date)}</span></a> : <span />}
    {newer ? <a class="card next" href={`/days/${newer.date}/`}><span class="eyebrow">Next →</span><b>{newer.post?.title ?? 'Review day'}</b><span class="muted">{formatDate(newer.date)}</span></a> : <span />}
  </nav>
</Base>

<style>
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a { display: flex; flex-direction: column; gap: 2px; padding: 16px 20px; text-decoration: none; transition: transform 0.2s; min-width: 0; }
  .pager a:hover { transform: translateY(-2px); }
  .pager b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pager .next { text-align: right; }
  .pager .muted { font-size: 13px; }
</style>
