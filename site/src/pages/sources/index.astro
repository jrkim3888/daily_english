---
import Base from '../../layouts/Base.astro';
import SourceCard from '../../components/SourceCard.astro';
import { getDays } from '../../lib/data';

const eps = getDays().filter((d) => d.post);
---
<Base title="Sources">
  <header class="page-head">
    <p class="eyebrow">Sources · {eps.length} episodes</p>
    <h1 class="display">From the <em>airwaves.</em></h1>
    <p class="muted lede">EBS 라디오 「입이 트이는 영어」 에피소드를 정리한 <a href="https://blog.naver.com/witjung">witjung 블로그</a> 글에서 표현을 모았어요.</p>
  </header>
  <div class="grid">
    {eps.map((d) => (
      <SourceCard post={d.post!} date={d.date} words={d.newVocab.length} sentences={d.newSentences.length} href={`/days/${d.date}/`} />
    ))}
  </div>
</Base>

<style>
  .page-head { margin: 12px 0 32px; }
  .page-head .eyebrow { margin: 0 0 10px; }
  .page-head h1 { font-size: clamp(48px, 8vw, 104px); }
  .lede { max-width: 52ch; margin: 14px 0 0; }
  .lede a { color: var(--ink-2); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
</style>
