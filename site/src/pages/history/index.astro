---
import Base from '../../layouts/Base.astro';
import HistoryView from '../../components/HistoryView.astro';
import { getMonths } from '../../lib/data';

const [latest] = getMonths();
---
<Base title="History">
  {latest ? <HistoryView year={latest.year} month={latest.month} /> : <p class="muted">아직 기록이 없어요.</p>}
</Base>
