---
import type { Post } from '../lib/data';
import { formatDate } from '../lib/data';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  words?: number;
  sentences?: number;
}
const { post, words = 0, sentences = 0 } = Astro.props;
---
<a class="source card" href={post.link} target="_blank" rel="noopener">
  <div class="cover">
    <span class="station">EBS 입이 트이는 영어</span>
    <span class="aired">{post.aired ? formatDate(post.aired) : '방송일 미상'}</span>
  </div>
  <div class="body">
    <p class="eyebrow">오늘의 소스</p>
    <h3>{post.title}</h3>
    <p class="meta">단어 {words}개 · 문장 {sentences}개</p>
    <span class="go">블로그 원문 보기 <Icon name="external" size={14} /></span>
  </div>
</a>

<style>
  .source { display: flex; flex-direction: column; text-decoration: none; overflow: hidden; height: 100%; transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .source:hover { transform: translateY(-3px); }
  .cover {
    flex: 1; min-height: 132px; display: flex; flex-direction: column; justify-content: space-between; padding: 16px 18px; color: #fff;
    background:
      radial-gradient(120% 140% at 100% 0%, var(--accent), transparent 55%),
      radial-gradient(90% 120% at 0% 100%, var(--lime), transparent 60%),
      #15161a;
  }
  .station { font-size: 12px; font-weight: 600; opacity: 0.85; }
  .aired { font-size: 22px; font-weight: 800; letter-spacing: -0.04em; }
  .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 4px; }
  .body .eyebrow { margin: 0; }
  h3 { margin: 0; font-size: 22px; font-weight: 750; line-height: 1.25; letter-spacing: -0.035em; }
  .meta { margin: 0; color: var(--muted); font-size: 13px; }
  .go { padding-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 650; color: var(--accent); }
</style>
