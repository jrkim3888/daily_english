---
import type { Post } from '../lib/data';
import { formatDateEn } from '../lib/data';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  date: string;
  words?: number;
  sentences?: number;
  href?: string; // where the card links; defaults to the blog post
  size?: 'lg' | 'sm';
}
const { post, date, words = 0, sentences = 0, href, size = 'sm' } = Astro.props;
const en = formatDateEn(date);
const target = href ?? post.link;
const external = !href;
---
<a class:list={['source', 'card', size]} href={target} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <div class="cover" aria-hidden="true">
    <span class="ep">{post.episode || '—'}</span>
    <span class="station">EBS · 입트영</span>
  </div>
  <div class="body">
    <p class="eyebrow">{external ? 'Today’s source' : `${en.month} ${en.day}, ${en.year}`}</p>
    <h3>{post.title}</h3>
    <p class="meta">
      {words > 0 && <span>{words} {words === 1 ? 'word' : 'words'}</span>}
      {sentences > 0 && <span>{sentences} {sentences === 1 ? 'sentence' : 'sentences'}</span>}
    </p>
    <span class="go">{external ? <>블로그 원문 <Icon name="external" size={14} /></> : <>공부한 날 보기 <Icon name="arrow" size={14} /></>}</span>
  </div>
</a>

<style>
  .source {
    display: flex; flex-direction: column; text-decoration: none; overflow: hidden; height: 100%;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s;
  }
  .source:hover { transform: translateY(-3px); }
  .cover {
    position: relative; aspect-ratio: 16 / 7; overflow: hidden;
    background:
      radial-gradient(120% 140% at 100% 0%, var(--accent), transparent 55%),
      radial-gradient(90% 120% at 0% 100%, var(--lime), transparent 60%),
      var(--ink);
    display: flex; align-items: flex-end; justify-content: space-between; padding: 14px 16px;
    color: #fff;
  }
  .ep { font-family: var(--serif); font-style: italic; font-size: 44px; line-height: 0.9; letter-spacing: -0.03em; }
  .station { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
  .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .body .eyebrow { margin: 0; }
  h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 24px; line-height: 1.12; letter-spacing: -0.015em; }
  .meta { margin: 0; display: flex; gap: 10px; color: var(--muted); font-size: 13px; }
  .go { margin-top: auto; padding-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--accent); }
  .lg .cover { aspect-ratio: auto; flex: 1; min-height: 150px; }
  .lg .ep { font-size: 72px; }
  .lg h3 { font-size: 28px; }
</style>
