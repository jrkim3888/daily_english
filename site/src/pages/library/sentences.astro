---
import Base from '../../layouts/Base.astro';
import LibraryHead from '../../components/LibraryHead.astro';
import SearchBar from '../../components/SearchBar.astro';
import Icon from '../../components/Icon.astro';
import { getAllSentences } from '../../lib/data';

const sentences = getAllSentences();
---
<Base title="Sentences">
  <LibraryHead active="sentences" count={sentences.length} />
  <SearchBar target=".s[data-item]" placeholder="문장 검색" />
  <ul class="slist" data-group>
    {sentences.map((s) => (
      <li class="s" data-item>
        <p>{s}</p>
        <button type="button" class="sp" data-action="speak" data-text={s} aria-label="문장 듣기"><Icon name="speak" size={14} /></button>
      </li>
    ))}
  </ul>
</Base>

<script src="../../lib/study.ts"></script>

<style>
  .slist { list-style: none; margin: 0; padding: 0; columns: 2 340px; column-gap: 10px; }
  .s {
    break-inside: avoid; display: flex; gap: 12px; align-items: flex-start; margin-bottom: 10px; padding: 16px 16px 16px 20px;
    border-radius: 18px; background: var(--surface); border: 1px solid var(--line);
  }
  .s p { margin: 0; flex: 1; font-family: var(--serif); font-size: 21px; line-height: 1.28; }
  .sp { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-solid); color: var(--ink-2); cursor: pointer; }
  .sp:hover { color: var(--accent); }
</style>
