---
import Base from '../layouts/Base.astro';
import { getAllVocab } from '../lib/data';

const vocab = getAllVocab();
const sections = ['Words', 'Phrasal Verbs', 'Idioms'].map((name) => ({
  name,
  items: vocab.filter((v) => v.section === name),
}));
---
<Base title="단어장">
  <h1>단어장</h1>
  <p class="muted">총 {vocab.length.toLocaleString()}개 · 최근에 추가된 순</p>
  <input class="search" type="search" placeholder="단어나 뜻으로 검색" data-filter=".vocab li" />
  <p class="muted count" aria-live="polite"></p>
  {sections.filter((s) => s.items.length).map((s) => (
    <section data-group>
      <h2>{s.name} <span>({s.items.length})</span></h2>
      <div class="card">
        <ul class="vocab">
          {s.items.map((v) => <li><span class="term">{v.term}</span><span class="meaning">{v.meaning}</span></li>)}
        </ul>
      </div>
    </section>
  ))}
</Base>

<script src="../lib/filter.ts"></script>
