---
import Base from '../../layouts/Base.astro';
import LibraryHead from '../../components/LibraryHead.astro';
import SearchBar from '../../components/SearchBar.astro';
import Spotlight from '../../components/Spotlight.astro';
import Icon from '../../components/Icon.astro';
import { getAllSentences, letterOf } from '../../lib/data';

const sentences = getAllSentences();
const letters = [...new Set(sentences.map(letterOf))];
---
<Base title="Sentences">
  <LibraryHead active="sentences" count={sentences.length} />
  <div class="lib">
    <div class="side"><Spotlight kind="sentence" /></div>
    <div class="main">
      <SearchBar target="[data-item]" placeholder="Search sentences" letters={letters} />
      <ul class="rows card" data-group>
        {sentences.map((s) => (
          <li class="s" data-item data-letter={letterOf(s)} data-text={s}>
            <p>{s}</p>
            <button type="button" class="sp" data-action="speak" data-text={s} aria-label="Listen"><Icon name="speak" size={14} /></button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<script src="../../lib/study.ts"></script>

<style>
  .lib { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; align-items: start; }
  .side { grid-column: 2; grid-row: 1; position: sticky; top: 84px; }
  .main { grid-column: 1; grid-row: 1; min-width: 0; }
  .s { display: flex; gap: 14px; align-items: center; padding: 13px 16px 13px 20px; cursor: pointer; transition: background 0.15s; }
  .s:hover { background: color-mix(in oklab, var(--ink) 4%, transparent); }
  .s:global(.selected) { background: color-mix(in oklab, var(--lime) 35%, transparent); }
  .s p { margin: 0; flex: 1; font-size: 16px; font-weight: 550; line-height: 1.5; letter-spacing: -0.02em; }
  .sp { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-solid); color: var(--ink-2); cursor: pointer; }
  .sp:hover { color: var(--accent); }
  @media (max-width: 900px) {
    .lib { grid-template-columns: 1fr; }
    .side { grid-column: 1; position: static; }
    .main { grid-row: 2; }
  }
</style>
